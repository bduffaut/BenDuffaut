# Copy to .env next to compose.yaml on the server (and in the repo for local dev).
# Everything here is read at runtime. Public build-time settings (site URL, Umami website
# id, Turnstile site key) are GitHub repository variables instead, see docs/deployment.md.

# --- Contact form email (SMTP) -------------------------------------------------------
# With Gmail: turn on 2-step verification, create an app password at
# https://myaccount.google.com/apppasswords, and use it as SMTP_PASS.
NUXT_CONTACT_TO=ben.duffaut@gmail.com
NUXT_CONTACT_FROM=ben.duffaut@gmail.com
NUXT_CONTACT_SMTP_HOST=smtp.gmail.com
NUXT_CONTACT_SMTP_PORT=465
NUXT_CONTACT_SMTP_SECURE=true
NUXT_CONTACT_SMTP_USER=ben.duffaut@gmail.com
NUXT_CONTACT_SMTP_PASS=

# Optional Cloudflare Turnstile secret. Only checked when the site key was set at build time.
NUXT_CONTACT_TURNSTILE_SECRET=

# --- Server only (compose.yaml) -------------------------------------------------------
# Image to run. Leave as is unless the repo moves.
# SITE_IMAGE=ghcr.io/bduffaut/benduffaut:latest
# SITE_PORT=3000

# Cloudflare Tunnel token, for `--profile tunnel`. Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Umami, for `--profile analytics`. Generate each with: openssl rand -hex 32
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# UMAMI_PORT=3001
# Where Postgres keeps analytics data. Defaults to a Docker volume on the SSD, which is
# what you want for a database; back it up to the external drive (docs/deployment.md).
# UMAMI_DATA_DIR=
