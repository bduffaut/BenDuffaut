{
  "name": "benduffaut.com",
  "private": true,
  "type": "module",
  "description": "Benjamin Duffaut's portfolio and resume site, served from a home server.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "assets": "node scripts/render-assets.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@nuxt/content": "^3.16.2",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-vue-next": "^1.0.0",
    "nodemailer": "^10.1.2",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
