# Copy to /etc/systemd/system/. User and path match the home server (bduffaut, repo cloned
# to ~/benduffaut.com); change both if that moves. See docs/deployment.md.
[Unit]
Description=Update benduffaut.com to the latest image
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=bduffaut
ExecStart=/usr/bin/bash /home/bduffaut/benduffaut.com/deploy/auto-update.sh
